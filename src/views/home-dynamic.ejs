<%- include('partials/header') %><section class="hero hero-demo text-white"><div class="container py-5"><p class="eyebrow">POWERING YOUR DIGITAL LIFESTYLE</p><h1>Premium Laptops, Computers &amp; Gadgets for Work, Gaming &amp; Everyday Life</h1><p class="lead">Discover quality technology products—all in one trusted store.</p><a href="/products" class="btn btn-primary btn-lg me-2">Browse Products</a><a href="/contact" class="btn btn-outline-light btn-lg">Message Us</a></div></section><section class="container py-5"><div class="d-flex justify-content-between align-items-end"><div><p class="eyebrow text-primary">CURATED TECH</p><h2>Featured Products</h2></div><a href="/products">View all products →</a></div><div class="row g-4 mt-1"><% featured.forEach(p=>{ %><div class="col-sm-6 col-lg-3"><%- include('partials/product-card',{p}) %></div><% }) %><%if(!featured.length){%><div class="col-12"><div class="empty-catalog">New products will appear here as they are added.</div></div><%}%></div></section><% if(featuredBrands.length){ %><section class="bg-light py-5"><div class="container"><p class="eyebrow text-primary">TRUSTED TECHNOLOGY</p><h2>Featured Brands</h2><div class="brand-wall mt-4"><% featuredBrands.forEach(brand=>{ %><% const opening=brand.website_url?`<a href="${brand.website_url}" target="_blank" rel="noopener" class="brand-item">`:'<div class="brand-item">'; const closing=brand.website_url?'</a>':'</div>'; %><%- opening %><% if(brand.logo_path){ %><img src="<%=brand.logo_path%>" alt="<%=brand.name%> logo" loading="lazy"><% } else { %><span><%=brand.name%></span><% } %><%- closing %><% }) %></div></div></section><% } %><section class="container py-5"><div class="about-panel"><div><p class="eyebrow text-primary">ABOUT JH JOOP HESED</p><h2>Your trusted technology partner</h2><p>Quality technology, practical guidance, competitive pricing, and dependable customer service.</p></div><div class="about-orb">JH<br>TECH</div></div></section><% if(testimonials.length){ %><section class="bg-light py-5"><div class="container"><p class="eyebrow text-primary">CUSTOMER STORIES</p><h2>What customers say</h2><div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel"><div class="carousel-inner"><% testimonials.forEach((testimonial,index)=>{ %><div class="carousel-item <%=index===0?'active':''%>"><div class="row justify-content-center"><div class="col-lg-8"><blockquote class="testimonial text-center"><% if(testimonial.photo){ %><img src="<%=testimonial.photo%>" class="testimonial-photo" alt="<%=testimonial.customer_name%>" loading="lazy"><% } %><div aria-label="<%=testimonial.rating%> out of 5 stars"><%= '★'.repeat(testimonial.rating || 5) %></div><p>“<%=testimonial.comment%>”</p><footer>— <%=testimonial.customer_name%><%=testimonial.company?', '+testimonial.company:''%></footer></blockquote></div></div></div><% }) %></div><button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button><button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button></div></div></section><% } %><%- include('partials/footer') %>
