<article class="card h-100 shadow-sm product-card"><% if (p.thumbnail_path) { %><img src="<%= p.thumbnail_path %>" alt="<%= p.name %>" class="card-img-top product-image"><% } else { %><div class="product-image bg-light d-flex align-items-center justify-content-center text-muted">Gadget</div><% } %><div class="card-body d-flex flex-column"><h3 class="h6"><%= p.name %></h3><p class="small text-muted mb-2"><%= p.brand_name || '' %></p><p class="fw-bold mb-3">₱<%= Number(p.discount_price || p.selling_price).toLocaleString('en-PH',{minimumFractionDigits:2}) %></p><a class="btn btn-outline-primary btn-sm mt-auto" href="/products/<%= p.slug %>">View details</a></div></article>
