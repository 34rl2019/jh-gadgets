<section class="container pb-5" id="reviews"><div class="review-summary card card-body mb-4"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3"><div><p class="eyebrow text-primary mb-1">CUSTOMER REVIEWS</p><h2 class="h3 mb-0"><%= reviewSummary.count ? reviewSummary.average.toFixed(1) : '—' %> <span class="stars">★★★★★</span> <small class="text-muted fs-6">(<%=reviewSummary.count%> reviews)</small></h2></div><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#writeReview">Write a Review</button></div><div class="rating-breakdown mt-3"><% [5,4,3,2,1].forEach(r=>{ const count=reviewSummary.breakdown[r]||0; const percent=reviewSummary.count?count/reviewSummary.count*100:0; %><div class="d-flex align-items-center gap-2"><span><%=r%> ★</span><div class="progress flex-grow-1"><div class="progress-bar" style="width:<%=percent%>%"></div></div><small><%=count%></small></div><%})%></div></div><form id="writeReview" class="collapse card card-body mb-4" method="post" action="/products/<%=product.slug%>/reviews" enctype="multipart/form-data"><h3 class="h5">Share your experience</h3><div class="row g-3"><div class="col-md-6"><label class="form-label">Customer name</label><input required maxlength="120" class="form-control" name="customer_name"></div><div class="col-md-6"><label class="form-label">Email address</label><input required type="email" class="form-control" name="customer_email"></div><div class="col-md-7"><label class="form-label">Review title</label><input required minlength="3" maxlength="180" class="form-control" name="review_title"></div><div class="col-md-5"><label class="form-label">Rating</label><select required class="form-select" name="rating"><option value="">Select rating</option><%[5,4,3,2,1].forEach(r=>{%><option value="<%=r%>"><%=r%> stars</option><%})%></select></div><div class="col-12"><label class="form-label">Review</label><textarea required minlength="15" maxlength="2000" class="form-control" rows="4" name="review"></textarea></div><div class="col-md-6"><label class="form-label">Photo (optional)</label><input class="form-control" type="file" accept="image/jpeg,image/png,image/webp" name="customer_photo"></div><div class="col-md-6"><label class="form-label">Purchase reference (optional)</label><input maxlength="120" class="form-control" name="purchase_reference"></div></div><p class="small text-muted mt-3 mb-2">Reviews are moderated before publication.</p><button class="btn btn-primary align-self-start">Submit review</button></form><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h3 mb-0">Customer reviews</h2><form class="d-flex gap-2" method="get"><select class="form-select form-select-sm" name="rating"><option value="">All ratings</option><%[5,4,3,2,1].forEach(r=>{%><option value="<%=r%>" <%=String(query.rating)===String(r)?'selected':''%>><%=r%> stars</option><%})%></select><select class="form-select form-select-sm" name="sort"><% [['newest','Newest'],['oldest','Oldest'],['highest','Highest rated'],['lowest','Lowest rated'],['helpful','Most helpful']].forEach(([value,label])=>{%><option value="<%=value%>" <%=query.sort===value?'selected':''%>><%=label%></option><%})%></select><button class="btn btn-sm btn-outline-primary">Apply</button></form></div><%if(query.review==='submitted'){%><div class="alert alert-success">Thanks—your review is pending approval.</div><%}%><%reviews.forEach(review=>{%><article class="review-card"><div class="stars"><%= '★'.repeat(review.rating) %></div><h3 class="h5 mb-1"><%=review.review_title%></h3><p class="mb-2"><%=review.review%></p><footer class="d-flex flex-wrap gap-2 align-items-center"><strong><%=review.customer_name%></strong><%if(review.purchase_verified){%><span class="badge text-bg-success">Verified purchase</span><%}%><span>· <%=new Date(review.created_at).toLocaleDateString()%></span><form method="post" action="/products/<%=product.slug%>/reviews/<%=review.id%>/helpful"><button class="btn btn-sm btn-outline-secondary">Helpful (<%=review.helpful_count%>)</button></form></footer></article><%})%><%if(!reviews.length){%><p class="text-muted">No approved reviews yet. Be the first to share your experience.</p><%}%></section>
