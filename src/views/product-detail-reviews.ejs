<%- include('partials/header') %><section class="container py-5"><div class="row g-5"><div class="col-lg-6"><%if(product.thumbnail_path){%><img class="detail-product-image rounded" src="<%=product.thumbnail_path%>" alt="<%=product.name%>"><%}else{%><div class="detail-image bg-light d-flex align-items-center justify-content-center">Product image unavailable</div><%}%></div><div class="col-lg-6"><p class="text-muted"><%=product.brand_name||'Gadget Store'%></p><h1><%=product.name%></h1><p class="h3 text-primary">₱<%=Number(product.discount_price||product.selling_price).toLocaleString('en-PH',{minimumFractionDigits:2})%></p><p><span class="badge text-bg-<%=product.stock_quantity?'success':'secondary'%>"><%=product.stock_quantity?'In stock':'Out of stock'%></span></p><p><%=product.description%></p><dl class="row"><dt class="col-4">Condition</dt><dd class="col-8 text-capitalize"><%=product.condition%></dd><dt class="col-4">Warranty</dt><dd class="col-8"><%=product.warranty||'Ask us'%></dd></dl><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#inquiry">Inquire now</button><form id="inquiry" class="collapse mt-3 card card-body" method="post" action="/products/<%=product.slug%>/inquire"><input required class="form-control mb-2" name="name" placeholder="Your name"><input required type="email" class="form-control mb-2" name="email" placeholder="Email"><textarea required class="form-control mb-2" name="message" placeholder="How can we help?"></textarea><button class="btn btn-dark">Send inquiry</button></form></div></div></section><%- include('partials/reviews') %><%- include('partials/footer') %>
