<%- include('partials/header') %><section class="container py-5"><h1>Frequently asked questions</h1><p class="text-muted">Answers to common questions about our products and services.</p><div class="accordion" id="faqAccordion"><% faqs.forEach((faq,index)=>{ %><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button <%=index?'collapsed':''%>" data-bs-toggle="collapse" data-bs-target="#faq<%=faq.id%>"><%=faq.question%></button></h2><div id="faq<%=faq.id%>" class="accordion-collapse collapse <%=index?'':'show'%>" data-bs-parent="#faqAccordion"><div class="accordion-body"><%=faq.answer%></div></div></div><% }) %><%if(!faqs.length){%><p class="text-muted">No FAQs have been published yet.</p><%}%></div></section><%- include('partials/footer') %>
