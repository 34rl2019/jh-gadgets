<%- include('partials/header') %><section class="hero hero-demo text-white"><div class="container py-5"><p class="eyebrow">POWERING YOUR DIGITAL LIFESTYLE</p><h1>Premium Laptops, Computers &amp; Gadgets for Work, Gaming &amp; Everyday Life</h1><p class="lead">Discover quality technology products—all in one trusted store.</p><a href="/products" class="btn btn-primary btn-lg me-2">Browse Products</a><a href="/contact" class="btn btn-outline-light btn-lg">Message Us</a></div></section><section class="container py-5"><div class="d-flex justify-content-between align-items-end"><div><p class="eyebrow text-primary">CURATED TECH</p><h2>Featured Products</h2></div><a href="/products">View all products →</a></div><div class="row g-4 mt-1"><%featured.forEach(p=>{%><div class="col-sm-6 col-lg-3"><%-include('partials/product-card',{p})%></div><%})%></div></section><%if(featuredBrands.length){%><section class="bg-light py-5"><div class="container"><p class="eyebrow text-primary">TRUSTED TECHNOLOGY</p><h2>Featured Brands</h2><div class="brand-wall mt-4"><%featuredBrands.forEach(brand=>{%><div class="brand-item"><%if(brand.logo_path){%><img src="<%=brand.logo_path%>" alt="<%=brand.name%> logo" loading="lazy"><%}else{%><span><%=brand.name%></span><%}%></div><%})%></div></div></section><%}%><%if(posts.length){%><section class="container py-5"><div class="d-flex justify-content-between align-items-end"><div><p class="eyebrow text-primary">LATEST ARTICLES</p><h2>From our blog</h2></div><a href="/blog">View all articles →</a></div><div class="row g-4 mt-1"><%posts.forEach(post=>{%><div class="col-md-4"><article class="card h-100 shadow-sm"><div class="card-body d-flex flex-column"><p class="small text-muted"><%=new Date(post.created_at).toLocaleDateString()%></p><h3 class="h5"><%=post.title%></h3><p class="text-muted"><%=post.excerpt||''%></p><a class="btn btn-outline-primary mt-auto" href="/blog/<%=post.slug%>">Read more</a></div></article></div><%})%></div></section><%}%><%if(faqs.length){%><section class="bg-light py-5"><div class="container"><div class="d-flex justify-content-between align-items-end"><div><p class="eyebrow text-primary">HELP CENTER</p><h2>Frequently asked questions</h2></div><a href="/faqs">View all FAQs →</a></div><div class="accordion mt-4" id="homeFaqs"><%faqs.forEach((faq,index)=>{%><div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button <%=index?'collapsed':''%>" type="button" data-bs-toggle="collapse" data-bs-target="#homeFaq<%=faq.id%>"><%=faq.question%></button></h3><div id="homeFaq<%=faq.id%>" class="accordion-collapse collapse <%=index?'show':''%>" data-bs-parent="#homeFaqs"><div class="accordion-body"><%=faq.answer%></div></div></div><%})%></div></div></section><%}%><%if(testimonials.length){%><section class="container py-5"><p class="eyebrow text-primary">CUSTOMER STORIES</p><h2>What customers say</h2><div class="row g-3 mt-2"><%testimonials.forEach(testimonial=>{%><div class="col-md-4"><blockquote class="testimonial">★★★★★<p>“<%=testimonial.comment%>”</p><footer>— <%=testimonial.customer_name%><%=testimonial.company?', '+testimonial.company:''%></footer></blockquote></div><%})%></div></section><%}%><%- include('partials/footer') %>
