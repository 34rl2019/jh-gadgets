<%- include('partials/header') %>
<section class="hero hero-demo text-white"><div class="container py-5"><p class="eyebrow">POWERING YOUR DIGITAL LIFESTYLE</p><h1>Premium technology, chosen with confidence.</h1><p class="lead">Quality gadgets, practical guidance, and dependable service—all in one trusted store.</p><a href="/products" class="btn btn-primary btn-lg me-2">Browse Products</a><a href="/contact" class="btn btn-outline-light btn-lg">Message Us</a></div></section>
<section class="container py-5"><div class="d-flex justify-content-between align-items-end"><div><p class="eyebrow text-primary">CURATED TECH</p><h2>Featured Products</h2></div><a href="/products">View all products →</a></div><div class="row g-4 mt-1"><% featured.forEach(p => { %><div class="col-sm-6 col-lg-3"><%- include('partials/product-card',{p}) %></div><% }) %><% if (!featured.length) { %><div class="col-12"><div class="empty-catalog">New products will appear here as they are added.</div></div><% } %></div></section>
<% if (featuredBrands.length) { %><section class="bg-light py-5"><div class="container"><p class="eyebrow text-primary">TRUSTED TECHNOLOGY</p><h2>Featured Brands</h2><div class="brand-wall mt-4"><% featuredBrands.forEach(brand => { %><div class="brand-item"><% if (brand.logo_path) { %><img src="<%=brand.logo_path%>" alt="<%=brand.name%> logo" loading="lazy"><% } else { %><span><%=brand.name%></span><% } %></div><% }) %></div></div></section><% } %>
<% if (testimonials.length) { %><section class="container py-5"><p class="eyebrow text-primary">CUSTOMER STORIES</p><h2>Real reviews from our customers</h2><div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel"><div class="carousel-inner"><% testimonials.forEach((testimonial,index) => { %><div class="carousel-item <%=index===0?'active':''%>"><blockquote class="testimonial text-center mx-auto"><% if (testimonial.customer_photo) { %><img src="<%=testimonial.customer_photo%>" class="testimonial-photo" alt="<%=testimonial.customer_name%>" loading="lazy"><% } %><div class="stars"><%= '★'.repeat(testimonial.rating) %></div><h3 class="h5 mt-2"><%=testimonial.review_title%></h3><p>“<%=testimonial.review%>”</p><footer>— <%=testimonial.customer_name%> · <a href="/products/<%=testimonial.product_slug%>"><%=testimonial.product_name%></a> · <%=new Date(testimonial.created_at).toLocaleDateString()%></footer></blockquote></div><% }) %></div><button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button><button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button></div></section><% } %>
<% if (posts.length) { %><section class="bg-light py-5"><div class="container"><div class="d-flex justify-content-between align-items-end"><div><p class="eyebrow text-primary">LATEST ARTICLES</p><h2>From our blog</h2></div><a href="/blog">View all articles →</a></div><div class="row g-4 mt-1"><% posts.forEach(post => { %><div class="col-md-4"><article class="card h-100 shadow-sm"><div class="card-body d-flex flex-column"><p class="small text-muted"><%=new Date(post.created_at).toLocaleDateString()%></p><h3 class="h5"><%=post.title%></h3><p class="text-muted"><%=post.excerpt || ''%></p><a class="btn btn-outline-primary mt-auto" href="/blog/<%=post.slug%>">Read more</a></div></article></div><% }) %></div></div></section><% } %>
<% if (faqs.length) { %><section class="container py-5"><div class="d-flex justify-content-between align-items-end"><div><p class="eyebrow text-primary">HELP CENTER</p><h2>Frequently asked questions</h2></div><a href="/faqs">View all FAQs →</a></div><div class="accordion mt-4" id="homeFaqs"><% faqs.forEach((faq,index) => { %><div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button <%=index ? 'collapsed' : ''%>" type="button" data-bs-toggle="collapse" data-bs-target="#homeFaq<%=faq.id%>"><%=faq.question%></button></h3><div id="homeFaq<%=faq.id%>" class="accordion-collapse collapse <%=index ? '' : 'show'%>" data-bs-parent="#homeFaqs"><div class="accordion-body"><%=faq.answer%></div></div></div><% }) %></div></section><% } %>
<%- include('partials/footer') %>
