<%- include('../partials/header') %><section class="container py-5"><h1><%= title %></h1><p class="text-muted">Manage this content through the protected REST API at <code>/api/<%= module === 'posts' ? 'blog_posts' : module %></code>.</p><div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Title / name</th><th>Status</th><th>Created</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.id %></td><td><%= r.title || r.question || r.customer_name %></td><td><%= r.status %></td><td><%= r.created_at %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>
