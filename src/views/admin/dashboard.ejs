<%- include('../partials/header') %><section class="container py-5"><div class="d-flex justify-content-between"><h1>Dashboard</h1><form method="post" action="/admin/logout"><button class="btn btn-outline-danger">Log out</button></form></div><div class="row g-3 my-2"><% Object.entries(stats).forEach(([label,value])=>{ %><div class="col-md-4 col-lg-3"><div class="card card-body"><span class="text-muted text-capitalize"><%= label.replace(/([A-Z])/g,' $1') %></span><strong class="display-6"><%= value.count %></strong></div></div><% }) %></div><div class="row g-3"><div class="col-lg-7"><div class="card"><div class="card-header">Latest products</div><ul class="list-group list-group-flush"><% latestProducts.forEach(p=>{ %><li class="list-group-item d-flex justify-content-between"><a href="/admin/products/<%=p.id%>/edit"><%=p.name%></a><span>₱<%=Number(p.selling_price).toLocaleString('en-PH',{minimumFractionDigits:2})%></span></li><% }) %><%if(!latestProducts.length){%><li class="list-group-item text-muted">No products yet.</li><%}%></ul></div></div><div class="col-lg-5"><div class="card"><div class="card-header">Recent messages</div><ul class="list-group list-group-flush"><% messages.forEach(m=>{ %><li class="list-group-item"><strong><%= m.name %></strong> — <%= m.message %></li><% }) %></ul></div></div></div><nav class="mt-4"><a href="/admin/products" class="btn btn-primary me-2">Products</a><a href="/admin/services" class="btn btn-outline-primary me-2">Services</a><a href="/admin/posts" class="btn btn-outline-primary me-2">Posts</a><a href="/admin/faqs" class="btn btn-outline-primary">FAQs</a></nav></section><%- include('../partials/footer') %>
