<%- include('../../partials/header') %><section class="container py-5"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="mb-0"><%= title %></h1><p class="text-muted mb-0">Manage published and draft <%= title.toLowerCase() %>.</p></div><a class="btn btn-primary" href="/admin/<%= module %>/new">Add <%= label %></a></div><% if(query.notice){ %><div class="alert alert-success">Record <%= query.notice %>.</div><% } %><form class="row g-2 card card-body mb-3"><div class="col-md-7"><input class="form-control" name="q" value="<%=query.q||''%>" placeholder="Search"></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option><% ['draft','published','archived'].forEach(status=>{ %><option value="<%=status%>" <%=query.status===status?'selected':''%>><%=status%></option><% }) %></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Title</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead><tbody><% rows.forEach(row=>{const name=row.title||row.question; %><tr><td><strong><%=name%></strong><div class="small text-muted"><%=row.excerpt||row.description||''%></div></td><td><%=row.status%></td><td><%=new Date(row.updated_at).toLocaleDateString()%></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/admin/<%=module%>/<%=row.id%>/edit">Edit</a><% if(row.status==='archived'){ %><form class="d-inline" method="post" action="/admin/<%=module%>/<%=row.id%>/restore"><button class="btn btn-sm btn-outline-success">Restore</button></form><% } else { %><form class="d-inline" method="post" action="/admin/<%=module%>/<%=row.id%>/archive"><button class="btn btn-sm btn-outline-warning">Archive</button></form><% } %><form class="d-inline" method="post" action="/admin/<%=module%>/<%=row.id%>/delete" onsubmit="return confirm('Delete this record permanently?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><% }) %><%if(!rows.length){%><tr><td colspan="4" class="text-center text-muted py-4">No records found.</td></tr><%}%></tbody></table></div></section><%- include('../../partials/footer') %>
