<%- include('../../partials/header') %><section class="container py-5" style="max-width:900px"><div class="d-flex justify-content-between"><h1><%=title%></h1><a class="btn btn-outline-secondary" href="/admin/<%=module%>">Back to list</a></div><%if(errors.length){%><div class="alert alert-danger mt-3"><%errors.forEach(error=>{%><div><%=error.msg%></div><%})%></div><%}%><form class="card card-body mt-3" method="post" action="/admin/<%=module%><%=row.id?'/'+row.id:''%>"><%if(module==='services'){%><label class="form-label">Service name</label><input required name="title" value="<%=row.title||''%>" class="form-control mb-3"><label class="form-label">Description</label><textarea required name="description" rows="8" class="form-control mb-3"><%=row.description||''%></textarea><div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="featured" id="featured" <%=row.featured?'checked':''%>><label for="featured" class="form-check-label">Featured service</label></div><%}else if(module==='faqs'){%><label class="form-label">Question</label><input required name="question" value="<%=row.question||''%>" class="form-control mb-3"><label class="form-label">Answer</label><textarea required name="answer" rows="8" class="form-control mb-3"><%=row.answer||''%></textarea><label class="form-label">Display order</label><input type="number" min="0" name="sort_order" value="<%=row.sort_order||0%>" class="form-control mb-3"><%}else{%><label class="form-label">Title</label><input required name="title" value="<%=row.title||''%>" class="form-control mb-3"><label class="form-label">Slug</label><input name="slug" value="<%=row.slug||''%>" class="form-control mb-3"><label class="form-label">Excerpt</label><textarea name="excerpt" rows="3" class="form-control mb-3"><%=row.excerpt||''%></textarea><label class="form-label">Content</label><textarea required name="content" rows="12" class="form-control mb-3"><%=row.content||''%></textarea><label class="form-label">SEO title</label><input name="meta_title" value="<%=row.meta_title||''%>" class="form-control mb-3"><label class="form-label">SEO description</label><textarea name="meta_description" rows="2" class="form-control mb-3"><%=row.meta_description||''%></textarea><%}%><label class="form-label">Status</label><select name="status" class="form-select"><%['draft','published'].forEach(status=>{%><option value="<%=status%>" <%=row.status===status?'selected':''%>><%=status%></option><%})%></select><button class="btn btn-primary mt-4">Save <%=module==='faqs'?'FAQ':module==='posts'?'post':'service'%></button></form></section><%- include('../../partials/footer') %>
