<%- include('../../partials/header') %><section class="container py-5"><div class="d-flex justify-content-between align-items-center"><div><p class="eyebrow text-primary">MODERATION</p><h1>Product reviews</h1></div><a href="/admin" class="btn btn-outline-primary">Dashboard</a></div><form class="row g-2 my-3"><div class="col-md-5"><input class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Search customer, product, title"></div><div class="col-sm-3 col-md-2"><select class="form-select" name="status"><option value="">All statuses</option><% ['pending','approved','rejected','hidden','archived'].forEach(s=>{ %><option value="<%=s%>" <%=filters.status===s?'selected':''%>><%=s%></option><%})%></select></div><div class="col-sm-2"><select class="form-select" name="rating"><option value="">All ratings</option><% [5,4,3,2,1].forEach(r=>{%><option value="<%=r%>" <%=String(filters.rating)===String(r)?'selected':''%>><%=r%> stars</option><%})%></select></div><div class="col-sm-2"><button class="btn btn-primary w-100">Filter</button></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Customer</th><th>Product</th><th>Rating</th><th>Review title</th><th>Date</th><th>Status</th><th>Homepage</th><th>Actions</th></tr></thead><tbody><% reviews.forEach(review=>{%><tr><td><strong><%=review.customer_name%></strong><br><small><%=review.customer_email%></small><%if(review.purchase_verified){%><br><span class="badge text-bg-success">Verified purchase</span><%}%></td><td><%=review.product_name%></td><td class="stars"><%= '★'.repeat(review.rating) %></td><td><strong><%=review.review_title%></strong><br><small><%=review.review%></small></td><td><%=new Date(review.created_at).toLocaleDateString()%></td><td><span class="badge text-bg-<%=review.status==='approved'?'success':review.status==='pending'?'warning':'secondary'%>"><%=review.status%></span></td><td><%=review.featured?'Featured':'—'%></td><td><div class="d-flex flex-wrap gap-1"><% [['approve','Approve'],['reject','Reject'],['hide','Hide'],[review.featured?'unfeature':'feature',review.featured?'Unfeature':'Feature'],['verify',review.purchase_verified?'Unverify':'Verify'],['archive','Archive'],['restore','Restore'],['delete','Delete']].forEach(([action,label])=>{%><form method="post" action="/admin/reviews/<%=review.id%>"><input type="hidden" name="action" value="<%=action%>"><button class="btn btn-sm btn-outline-<%=action==='delete'?'danger':'primary'%>" <%=action==='feature'&&review.status!=='approved'?'disabled':''%>><%=label%></button></form><%})%></div></td></tr><%})%><%if(!reviews.length){%><tr><td colspan="8" class="text-center text-muted py-4">No reviews match these filters.</td></tr><%}%></tbody></table></div></section><%- include('../../partials/footer') %>
