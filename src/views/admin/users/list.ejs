<%- include('../../partials/header') %><section class="container py-5"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="mb-0">Users</h1><p class="text-muted mb-0">Super Admin access only</p></div><a class="btn btn-primary" href="/admin/users/new">Add user</a></div><% if (typeof query !== 'undefined' && query.notice) { %><div class="alert alert-success">User saved.</div><% } %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last login</th><th>Actions</th></tr></thead><tbody><% users.forEach(user => { %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= user.roles || 'No role' %></td><td><span class="badge text-bg-<%= user.status === 'active' ? 'success' : 'secondary' %>"><%= user.status %></span></td><td><%= user.last_login_at ? new Date(user.last_login_at).toLocaleString() : 'Never' %></td><td><a class="btn btn-sm btn-outline-primary" href="/admin/users/<%= user.id %>/edit">Edit</a><form class="d-inline" method="post" action="/admin/users/<%= user.id %>/toggle"><button class="btn btn-sm btn-outline-warning"><%= user.status === 'active' ? 'Deactivate' : 'Activate' %></button></form></td></tr><% }) %></tbody></table></div></section><%- include('../../partials/footer') %>
