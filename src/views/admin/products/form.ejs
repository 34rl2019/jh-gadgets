<%- include('../../partials/header') %><section class="container py-5"><div class="d-flex justify-content-between"><h1><%=title%></h1><a href="/admin/products" class="btn btn-outline-secondary">Back to list</a></div><%if(typeof errors!=='undefined'&&errors.length){%><div class="alert alert-danger"><ul class="mb-0"><%errors.forEach(e=>{%><li><%=e.msg%></li><%})%></ul></div><%}%><form method="post" enctype="multipart/form-data" action="<%=action%>" class="card card-body shadow-sm"><div class="row g-3"><div class="col-md-8"><label class="form-label">Product name *</label><input required name="name" value="<%=product.name||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label">SKU *</label><input required name="sku" value="<%=product.sku||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label d-flex justify-content-between">Brand <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#brandModal">+ New</button></label><select id="brand_id" name="brand_id" class="form-select"><option value="">None</option><%brands.forEach(b=>{%><option value="<%=b.id%>" <%=String(product.brand_id)===String(b.id)?'selected':''%>><%=b.name%></option><%})%></select></div><div class="col-md-4"><label class="form-label d-flex justify-content-between">Category <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#categoryModal">+ New</button></label><select id="category_id" name="category_id" class="form-select"><option value="">None</option><%categories.forEach(c=>{%><option value="<%=c.id%>" <%=String(product.category_id)===String(c.id)?'selected':''%>><%=c.name%></option><%})%></select></div><div class="col-md-4"><label class="form-label">Model</label><input name="model" value="<%=product.model||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Regular price *</label><input required min="0" step="0.01" type="number" name="selling_price" value="<%=product.selling_price||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Discount price</label><input min="0" step="0.01" type="number" name="discount_price" value="<%=product.discount_price||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Cost price</label><input min="0" step="0.01" type="number" name="cost_price" value="<%=product.cost_price||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Cash price</label><input min="0" step="0.01" type="number" name="cash_price" value="<%=product.cash_price||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Barcode</label><input name="barcode" value="<%=product.barcode||''%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Stock quantity</label><input min="0" type="number" name="stock_quantity" value="<%=product.stock_quantity||0%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Low-stock alert</label><input min="0" type="number" name="low_stock_alert" value="<%=product.low_stock_alert||3%>" class="form-control"></div><div class="col-md-4"><label class="form-label">Status</label><select name="status" class="form-select"><option value="draft" <%=product.status==='draft'?'selected':''%>>Hidden</option><option value="published" <%=product.status==='published'?'selected':''%>>Active</option></select></div><div class="col-12"><label class="form-label">Description</label><textarea name="description" rows="5" class="form-control"><%=product.description||''%></textarea></div><div class="col-md-6"><label class="form-label">Thumbnail (JPG, PNG, WEBP; max 5 MB)</label><input id="image" accept="image/jpeg,image/png,image/webp" type="file" name="image" class="form-control"><img id="preview" class="preview mt-2 <%=product.thumbnail_path?'':'d-none'%>" src="<%=product.thumbnail_path||''%>" alt="Image preview"></div><div class="col-md-6"><label class="form-label">Gallery images (up to 8)</label><input accept="image/jpeg,image/png,image/webp" type="file" name="gallery" multiple class="form-control"></div><div class="col-12 d-flex gap-3"><div class="form-check"><input class="form-check-input" type="checkbox" name="featured" id="featured" <%=product.featured?'checked':''%>><label class="form-check-label" for="featured">Featured</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="new_arrival" id="arrival" <%=product.new_arrival?'checked':''%>><label class="form-check-label" for="arrival">New arrival</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="best_seller" id="best" <%=product.best_seller?'checked':''%>><label class="form-check-label" for="best">Best seller</label></div></div></div><button class="btn btn-primary mt-4">Save product</button></form></section><% [['brandModal','New brand','brands','brand_id'],['categoryModal','New category','categories','category_id']].forEach(([id,label,entity,select])=>{ %><div class="modal fade" id="<%=id%>" tabindex="-1"><div class="modal-dialog"><form class="modal-content quick-create" data-entity="<%=entity%>" data-select="<%=select%>"><div class="modal-header"><h2 class="modal-title fs-5"><%=label%></h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input required name="name" class="form-control" placeholder="Name"><p class="text-danger small mt-2 mb-0"></p></div><div class="modal-footer"><button class="btn btn-primary">Create</button></div></form></div></div><% }) %><script>document.getElementById('image').addEventListener('change',e=>{const f=e.target.files[0],p=document.getElementById('preview');if(f){p.src=URL.createObjectURL(f);p.classList.remove('d-none')}});document.querySelectorAll('.quick-create').forEach(f=>f.addEventListener('submit',async e=>{e.preventDefault();const r=await fetch('/api/'+f.dataset.entity,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({name:new FormData(f).get('name')})}),j=await r.json(),error=f.querySelector('.text-danger');if(!r.ok){error.textContent=j.message;return}document.getElementById(f.dataset.select).add(new Option(j.data.name,j.data.id,true,true));bootstrap.Modal.getInstance(f.closest('.modal')).hide();f.reset();error.textContent=''}))</script><%- include('../../partials/footer') %>
