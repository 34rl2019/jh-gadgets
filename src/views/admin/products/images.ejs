<%- include('../../partials/header') %><section class="container py-5"><div class="d-flex justify-content-between align-items-center"><div><h1 class="mb-0">Manage images</h1><p class="text-muted"><%= product.name %></p></div><a class="btn btn-outline-secondary" href="/admin/products/<%= product.id %>/edit">Back to product</a></div><% if (query.notice) { %><div class="alert alert-success">Images <%= query.notice %>.</div><% } %><form method="post" enctype="multipart/form-data" action="/admin/products/<%= product.id %>/images" class="card card-body mb-4"><label class="form-label">Upload additional images</label><input required type="file" name="gallery" multiple accept="image/jpeg,image/png,image/webp" class="form-control"><small class="text-muted mt-2">JPG, PNG, or WEBP; up to 8 images per upload, 5 MB each.</small><button class="btn btn-primary mt-3 align-self-start">Upload images</button></form><% if (!images.length) { %><div class="alert alert-light border">No gallery images yet.</div><% } else { %><p class="text-muted">Drag the cards to reorder the gallery. Choose one image as the product primary image.</p><form id="orderForm" method="post" action="/admin/products/<%= product.id %>/images/reorder"><input type="hidden" name="order" id="imageOrder"></form><div class="row g-3" id="imageGrid"><% images.forEach(image => { %><div class="col-sm-6 col-lg-3" draggable="true" data-id="<%= image.id %>"><div class="card h-100"><img src="<%= image.path %>" class="card-img-top admin-gallery-image" alt="<%= image.alt_text || product.name %>"><div class="card-body"><% if (product.thumbnail_path === image.path) { %><span class="badge text-bg-primary">Primary image</span><% } %><div class="d-flex flex-wrap gap-2 mt-2"><form method="post" action="/admin/products/<%= product.id %>/images/<%= image.id %>/thumbnail"><button class="btn btn-sm btn-outline-primary">Set primary</button></form><form method="post" action="/admin/products/<%= product.id %>/images/<%= image.id %>/delete" onsubmit="return confirm('Delete this image?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div></div><% }) %></div><button type="button" id="saveOrder" class="btn btn-outline-primary mt-3">Save image order</button><% } %></section><script>const grid=document.getElementById('imageGrid');let dragged;if(grid){grid.addEventListener('dragstart',event=>dragged=event.target.closest('[data-id]'));grid.addEventListener('dragover',event=>event.preventDefault());grid.addEventListener('drop',event=>{event.preventDefault();const target=event.target.closest('[data-id]');if(target&&dragged&&target!==dragged)target.before(dragged)});document.getElementById('saveOrder').addEventListener('click',()=>{document.getElementById('imageOrder').value=[...grid.children].map(card=>card.dataset.id).join(',');document.getElementById('orderForm').submit()})}</script><%- include('../../partials/footer') %>
