<%- include('../../partials/header') %><section class="container py-5"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="mb-0">Products</h1><p class="text-muted mb-0"><%= result.total %> products</p></div><a class="btn btn-primary" href="/admin/products/new">Add product</a></div><% if(filters.notice){ %><div class="alert alert-success">Product <%=filters.notice%>.</div><% } %><form class="card card-body mb-3"><div class="row g-2"><div class="col-md-5"><input class="form-control" name="q" value="<%=filters.q||''%>" placeholder="Search name or SKU"></div><div class="col-md-3"><select class="form-select" name="category"><option value="">All categories</option><% categories.forEach(c=>{%><option value="<%=c.id%>" <%=String(filters.category)===String(c.id)?'selected':''%>><%=c.name%></option><%})%></select></div><div class="col-md-2"><select class="form-select" name="status"><option value="">All statuses</option><% ['draft','published','archived'].forEach(s=>{%><option value="<%=s%>" <%=filters.status===s?'selected':''%>><%=s%></option><%})%></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Image</th><th><a href="?sort=name">Product</a></th><th>SKU</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Date added</th><th>Actions</th></tr></thead><tbody><% result.items.forEach(p=>{%><tr><td><%if(p.thumbnail_path){%><img class="admin-thumb" src="<%=p.thumbnail_path%>" alt=""><%}else{%><span class="text-muted">—</span><%}%></td><td><strong><%=p.name%></strong><%if(p.featured){%><span class="badge text-bg-info ms-1">Featured</span><%}%></td><td><%=p.sku%></td><td><%=p.category_name||'—'%></td><td>₱<%=Number(p.selling_price).toLocaleString('en-PH',{minimumFractionDigits:2})%></td><td><span class="badge text-bg-<%=p.stock_quantity===0?'danger':p.stock_quantity<=p.low_stock_alert?'warning':'success'%>"><%=p.stock_quantity===0?'Out of stock':p.stock_quantity<=p.low_stock_alert?'Low stock':'In stock'%> (<%=p.stock_quantity%>)</span></td><td><%=p.status%></td><td><%=new Date(p.created_at).toLocaleDateString()%></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/products/<%=p.slug%>">View</a><a class="btn btn-sm btn-outline-secondary" href="/admin/products/<%=p.id%>/edit">Edit</a><%if(p.status==='archived'){%><form class="d-inline" method="post" action="/admin/products/<%=p.id%>/restore"><button class="btn btn-sm btn-outline-success">Restore</button></form><%}else{%><form class="d-inline" method="post" action="/admin/products/<%=p.id%>/archive"><button class="btn btn-sm btn-outline-warning">Archive</button></form><%}%><form class="d-inline" method="post" action="/admin/products/<%=p.id%>/delete" onsubmit="return confirm('Permanently delete this product?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><%})%><%if(!result.items.length){%><tr><td colspan="9" class="text-center text-muted py-4">No products found.</td></tr><%}%></tbody></table></div><%if(result.pages>1){%><nav><ul class="pagination"><%for(let n=1;n<=result.pages;n++){%><li class="page-item <%=n===result.page?'active':''%>"><a class="page-link" href="?page=<%=n%>&q=<%=filters.q||''%>&category=<%=filters.category||''%>&status=<%=filters.status||''%>"><%=n%></a></li><%}%></ul></nav><%}%></section><%- include('../../partials/footer') %>
