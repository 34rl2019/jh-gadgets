<%- include('partials/header') %><section class="container py-5"><h1>Blog</h1><div class="row g-4 mt-1"><%posts.forEach(post=>{%><div class="col-md-6 col-lg-4"><article class="card h-100"><div class="card-body"><h2 class="h4"><%=post.title%></h2><p class="text-muted"><%=post.excerpt||''%></p><a class="btn btn-outline-primary" href="/blog/<%=post.slug%>">Read more</a></div></article></div><%})%><%if(!posts.length){%><p class="text-muted">No posts published yet.</p><%}%></div></section><%- include('partials/footer') %>
