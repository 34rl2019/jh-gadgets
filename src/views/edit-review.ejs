<%- include('partials/header') %><section class="container py-5" style="max-width:760px"><p class="eyebrow text-primary">CUSTOMER REVIEW</p><h1 class="h3">Edit your review</h1><p class="text-muted">Your update will be reviewed again before it is published.</p><form class="card card-body" method="post"><label class="form-label">Review title</label><input class="form-control mb-3" required minlength="3" maxlength="180" name="review_title" value="<%=review.review_title%>"><label class="form-label">Rating</label><select class="form-select mb-3" required name="rating"><%[5,4,3,2,1].forEach(r=>{%><option value="<%=r%>" <%=review.rating===r?'selected':''%>><%=r%> stars</option><%})%></select><label class="form-label">Review</label><textarea class="form-control mb-3" required minlength="15" maxlength="2000" rows="6" name="review"><%=review.review%></textarea><button class="btn btn-primary align-self-start">Save changes</button></form></section><%- include('partials/footer') %>
