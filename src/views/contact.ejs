<%- include('partials/header') %><section class="container py-5 col-lg-7"><h1>Contact us</h1><p class="text-muted">We’ll get back to you as soon as possible.</p><% if (typeof success !== 'undefined') { %><div class="alert alert-success"><%= success %></div><% } %><form method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Name</label><input required name="name" class="form-control"></div><div class="col-md-6"><label class="form-label">Email</label><input required type="email" name="email" class="form-control"></div><div class="col-12"><label class="form-label">Phone</label><input name="phone" class="form-control"></div><div class="col-12"><label class="form-label">Message</label><textarea required name="message" minlength="10" rows="5" class="form-control"></textarea></div><div><button class="btn btn-primary">Send message</button></div></form></section><%- include('partials/footer') %>
