<%- include('partials/header') %>
<section class="container py-5"><% const gallery = [product.thumbnail_path, ...images.map(image => image.path)].filter((path, index, all) => path && all.indexOf(path) === index); %>
<% if (query.inquiry === 'sent') { %><div class="alert alert-success">Your inquiry has been sent.</div><% } %><div class="row g-5"><div class="col-lg-6"><div class="product-gallery" data-gallery><% if (gallery.length) { %><div class="gallery-stage"><img id="galleryMain" class="gallery-main" src="<%= gallery[0] %>" alt="<%= product.name %>"><button type="button" class="gallery-control previous" aria-label="Previous image">‹</button><button type="button" class="gallery-control next" aria-label="Next image">›</button><button type="button" class="gallery-expand" aria-label="View fullscreen image">⛶</button></div><div class="gallery-thumbnails"><% gallery.forEach((path, index) => { %><button type="button" class="gallery-thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= path %>" aria-label="View image <%= index + 1 %>"><img src="<%= path %>" alt="<%= product.name %> image <%= index + 1 %>" loading="lazy"></button><% }) %></div><% } else { %><div class="detail-image bg-light d-flex align-items-center justify-content-center text-muted">Product image unavailable</div><% } %></div></div><div class="col-lg-6"><p class="text-muted"><%= product.brand_name || 'Gadget Store' %></p><h1><%= product.name %></h1><p class="h3 text-primary">₱<%= Number(product.discount_price || product.selling_price).toLocaleString('en-PH',{minimumFractionDigits:2}) %></p><p><span class="badge text-bg-<%= product.stock_quantity ? 'success' : 'secondary' %>"><%= product.stock_quantity ? 'In stock' : 'Out of stock' %></span></p><p><%= product.description %></p><dl class="row"><dt class="col-4">Condition</dt><dd class="col-8 text-capitalize"><%= product.condition %></dd><dt class="col-4">Warranty</dt><dd class="col-8"><%= product.warranty || 'Ask us' %></dd><dt class="col-4">SKU</dt><dd class="col-8"><%= product.sku %></dd></dl><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#inquiry">Inquire now</button><form id="inquiry" class="collapse mt-3 card card-body" method="post" action="/products/<%= product.slug %>/inquire"><input required class="form-control mb-2" name="name" placeholder="Your name"><input required type="email" class="form-control mb-2" name="email" placeholder="Email"><input class="form-control mb-2" name="phone" placeholder="Phone"><textarea required class="form-control mb-2" name="message" placeholder="How can we help?"></textarea><button class="btn btn-dark">Send inquiry</button></form></div></div></section><div class="gallery-lightbox" id="galleryLightbox" hidden><button type="button" aria-label="Close fullscreen image">×</button><img alt="<%= product.name %> fullscreen preview"></div><script>document.querySelectorAll('[data-gallery]').forEach(gallery=>{const main=gallery.querySelector('#galleryMain'),thumbs=[...gallery.querySelectorAll('.gallery-thumb')],lightbox=document.querySelector('#galleryLightbox');let index=0,startX=0;const show=n=>{index=(n+thumbs.length)%thumbs.length;main.classList.add('is-changing');setTimeout(()=>{main.src=thumbs[index].dataset.image;thumbs.forEach((thumb,i)=>thumb.classList.toggle('active',i===index));main.classList.remove('is-changing')},120)};thumbs.forEach((thumb,i)=>thumb.addEventListener('click',()=>show(i)));gallery.querySelector('.previous').addEventListener('click',()=>show(index-1));gallery.querySelector('.next').addEventListener('click',()=>show(index+1));gallery.querySelector('.gallery-expand').addEventListener('click',()=>{lightbox.querySelector('img').src=main.src;lightbox.hidden=false});lightbox.querySelector('button').addEventListener('click',()=>lightbox.hidden=true);gallery.addEventListener('touchstart',event=>startX=event.touches[0].clientX,{passive:true});gallery.addEventListener('touchend',event=>{const delta=event.changedTouches[0].clientX-startX;if(Math.abs(delta)>40)show(index+(delta>0?-1:1))},{passive:true});document.addEventListener('keydown',event=>{if(lightbox.hidden&&['ArrowLeft','ArrowRight'].includes(event.key))show(index+(event.key==='ArrowLeft'?-1:1));if(event.key==='Escape')lightbox.hidden=true})});</script><%- include('partials/footer') %>
